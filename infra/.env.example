# Copy to infra/.env (docker compose) and/or the repo-root .env (scripts/serve.py, scripts/db_init.py).

# --- Tiger Data / TimescaleDB -------------------------------------------------------------------------
# Unset = no persistence (the pipeline runs fine, /api/runs returns {"available": false}).
# Local compose db:   postgresql://vbw:vbw@db:5432/vbw          (from inside compose)
#                     postgresql://vbw:vbw@localhost:5432/vbw   (from the host)
# Tiger Cloud:        postgres://tsdbadmin:<password>@<id>.<project>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL=
POSTGRES_PASSWORD=vbw
# 1 = the server applies infra/sql/*.sql on startup (idempotent). 0 = run scripts/db_init.py yourself.
VBW_DB_AUTO_INIT=1

# --- Server --------------------------------------------------------------------------------------------
# Extra CORS origins besides http://localhost:3000, comma-separated (e.g. http://<vultr-ip>:3000).
VBW_CORS_ORIGINS=

# --- Console -------------------------------------------------------------------------------------------
# Pipeline URL as seen from the browser; baked into the console at build time.
NEXT_PUBLIC_VBW_API=http://localhost:8000
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=

# --- Edge (compose --profile edge) -----------------------------------------------------------------------
# Domain with an A record pointing at this host; then set NEXT_PUBLIC_VBW_API=https://<domain>.
VBW_DOMAIN=
