# Copy to .env.local and fill in. Never commit real keys.

# Pipeline server (FastAPI) base URL. The console derives the WebSocket URL from it (/ws).
# Public by design: it is shipped to the browser.
NEXT_PUBLIC_VBW_API=http://localhost:8000

# Cartesia TTS for voice callouts. Server-side only (read by app/api/tts/route.ts, never sent to the client).
# Without it the console falls back to the browser's speechSynthesis voice.
CARTESIA_API_KEY=
# Optional overrides (defaults shown).
# CARTESIA_MODEL_ID=sonic-3.6
# CARTESIA_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b
# CARTESIA_VERSION=2026-08-14
